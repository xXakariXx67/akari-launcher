{
  "name": "akari-launcher",
  "version": "1.0.5",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "pnpm exec electron-builder",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\publish.ps1"
  },
  "dependencies": {
    "@xmcl/installer": "^6.3.4",
    "axios": "^1.20.0",
    "electron-updater": "^6.3.9",
    "fs-extra": "^11.4.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.akari.launcher",
    "productName": "Akari Launcher",
    "publish": {
      "provider": "github",
      "owner": "xXakariXx67",
      "repo": "akari-launcher"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon/akari-launcher.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}